
# Ad slot IDs, one per placement (AdSense > Ads > By ad unit > Display ads).
# A placement renders only when its slot is set — leave any blank to disable it.
NEXT_PUBLIC_AD_SLOT_ARTICLE_END=
NEXT_PUBLIC_AD_SLOT_TOOL_FOOTER=
NEXT_PUBLIC_AD_SLOT_RESOURCES_INDEX=

# Google Search Console > Add property > URL prefix > HTML tag.
# Paste ONLY the content="..." value. (Domain-property DNS verification is better if you can do it.)
NEXT_PUBLIC_GSC_VERIFICATION=


# --- Public API / MCP (optional) ---
# Requests per minute per IP for /api/mcp and /api/v1/*. Default 60.
API_RATE_LIMIT_PER_MIN=60

# --- Play Store build (Trusted Web Activity). Leave empty until you have them. ---
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT=
