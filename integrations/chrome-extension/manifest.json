{
  "manifest_version": 3,
  "name": "FreelanceShield — Contract Checker for Freelancers",
  "short_name": "FreelanceShield",
  "version": "1.0.0",
  "description": "Select any contract text, right-click, and see risky clauses and missing protections. Runs entirely in your browser.",
  "homepage_url": "https://freelanceshield.me",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "FreelanceShield", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "minimum_chrome_version": "102"
}
